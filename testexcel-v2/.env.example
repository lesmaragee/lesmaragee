# Copy this file's contents into Hostinger hPanel's Node.js app "Environment
# Variables" screen. Never commit an actual .env file with real values —
# .gitignore in this folder already excludes it.

# --- MySQL (Hostinger managed database) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- SMTP notification (Hostinger's own mail hosting, via Nodemailer) ---
# Use the SMTP details from hPanel → Emails for the mailbox that should send
# the notification (e.g. notifications@testexcel.example).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Defaults to info@testexcel.tech in server.js if left unset here — only set
# this if the notification inbox should ever be something else.
NOTIFY_TO_EMAIL=

# --- Google reCAPTCHA (v2 checkbox) ---
# Register the site at https://www.google.com/recaptcha/admin/create for
# testexcel.tech (and localhost, for local testing). The site key goes into
# index.html / services/technology-talent.html's data-sitekey attribute
# (replace YOUR_RECAPTCHA_SITE_KEY there) — it's public, safe to commit. The
# secret key below must only ever live here, never in frontend code or the repo.
RECAPTCHA_SECRET_KEY=

# --- CORS ---
# The exact production origin the API should accept requests from.
ALLOWED_ORIGIN=https://testexcel.example

# --- Server ---
PORT=3001
