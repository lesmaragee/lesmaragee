# Copy this file's contents into Hostinger hPanel's Node.js app "Environment
# Variables" screen. Never commit an actual .env file with real values —
# .gitignore in this folder already excludes it.

# --- MySQL (Hostinger managed database) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- SMTP notification (Hostinger's own mail hosting, via Nodemailer) ---
# Use the SMTP details from hPanel → Emails for the mailbox that should send
# the notification (e.g. notifications@testexcel.example).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Defaults to info@testexcel.tech in server.js if left unset here — only set
# this if the notification inbox should ever be something else.
NOTIFY_TO_EMAIL=

# --- Google reCAPTCHA (v3, invisible/score-based) ---
# Register the site at https://www.google.com/recaptcha/admin/create as
# reCAPTCHA v3, for testexcel.tech (and localhost, for local testing). The
# site key goes into the ?render= query param of the recaptcha/api.js script
# tag AND the RECAPTCHA_SITE_KEY constant in script.js (replace
# YOUR_RECAPTCHA_SITE_KEY in both index.html, services/technology-talent.html
# and script.js) — it's public, safe to commit. The secret key below must
# only ever live here, never in frontend code or the repo.
RECAPTCHA_SECRET_KEY=
# Minimum score (0.0-1.0) to accept a submission; Google recommends starting
# at 0.5 and adjusting based on real traffic. Lower = more permissive.
RECAPTCHA_SCORE_THRESHOLD=0.5

# --- CORS ---
# The exact production origin the API should accept requests from.
ALLOWED_ORIGIN=https://testexcel.example

# --- Server ---
PORT=3001
